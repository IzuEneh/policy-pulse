CREATE TABLE summary (
  id TEXT PRIMARY KEY,
  title TEXT NOT NULL,
  summary TEXT NOT NULL
);

CREATE TABLE notable_section (
  id INTEGER PRIMARY KEY,
  bill_id TEXT NOT NULL,
  title TEXT NOT NULL,
  description TEXT NOT NULL,
  FOREIGN KEY (bill_id) REFERENCES summary (id)
);

CREATE TABLE documents (
  id TEXT PRIMARY KEY,
  file BLOB NOT NULL
);

